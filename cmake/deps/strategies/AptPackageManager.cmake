# cmake/deps/strategies/AptPackageManager.cmake — Strategy: system packages via
# find_package / pkg_check_modules (probed QUIET so the chain can fall through).

include_guard(GLOBAL)

function(deps_apt_can_resolve NAME OUT_VAR)
    set(_ok FALSE)
    deps_decl_get(${NAME} APT _apt)
    if(NOT _apt OR _apt STREQUAL "OFF")
        set(${OUT_VAR} FALSE PARENT_SCOPE)
        return()
    endif()
    deps_decl_get(${NAME} APT_METHOD _method)
    if(_method STREQUAL "FIND_PACKAGE")
        deps_decl_get(${NAME} APT_FIND_NAME _pkg)
        if(NOT _pkg)
            set(_pkg ${NAME})
        endif()
        deps_decl_get(${NAME} APT_COMPONENTS _comps)
        if(_comps)
            find_package(${_pkg} QUIET COMPONENTS ${_comps})
        else()
            find_package(${_pkg} QUIET)
        endif()
        if(${_pkg}_FOUND)
            set(_ok TRUE)
            deps_decl_get(${NAME} APT_LINK_VARS _lv)
            set(_libs "")
            foreach(_v ${_lv})
                list(APPEND _libs ${${_v}})
            endforeach()
            deps_decl_get(${NAME} APT_IMPORTED_TARGETS _tgts)
            if(_tgts)
                list(APPEND _libs ${_tgts})
            endif()
            deps_decl_get(${NAME} APT_INCLUDE_VAR _incvar)
            deps_decl_get(${NAME} APT_VERSION_VAR _vvar)
            set_property(GLOBAL PROPERTY deps.apt.${NAME}.libs "${_libs}")
            set_property(GLOBAL PROPERTY deps.apt.${NAME}.inc "${${_incvar}}")
            set_property(GLOBAL PROPERTY deps.apt.${NAME}.ver "${${_vvar}}")
        endif()
    elseif(_method STREQUAL "PKG_CONFIG")
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            deps_decl_get(${NAME} APT_PKG_PREFIX _prefix)
            deps_decl_get(${NAME} APT_PKG_MODULES _mods)
            if(_mods)
                pkg_check_modules(${_prefix} QUIET IMPORTED_TARGET ${_mods})
                if(${_prefix}_FOUND)
                    set(_ok TRUE)
                endif()
            endif()
        endif()
    endif()
    set_property(GLOBAL PROPERTY deps.apt.${NAME}.ok ${_ok})
    set(${OUT_VAR} ${_ok} PARENT_SCOPE)
endfunction()

function(deps_apt_resolve NAME)
    get_property(_ok GLOBAL PROPERTY deps.apt.${NAME}.ok)
    if(NOT _ok)
        return()
    endif()
    deps_decl_get(${NAME} APT_METHOD _method)
    deps_decl_get(${NAME} DEFINITIONS _defs)

    set(_libs "")
    set(_inc "")
    set(_ver "")
    if(_method STREQUAL "FIND_PACKAGE")
        get_property(_libs GLOBAL PROPERTY deps.apt.${NAME}.libs)
        get_property(_inc  GLOBAL PROPERTY deps.apt.${NAME}.inc)
        get_property(_ver  GLOBAL PROPERTY deps.apt.${NAME}.ver)
    elseif(_method STREQUAL "PKG_CONFIG")
        deps_decl_get(${NAME} APT_IMPORTED_TARGETS _tgts)
        set(_libs "${_tgts}")
        deps_decl_get(${NAME} APT_VERSION_VAR _vvar)
        if(_vvar)
            set(_ver "${${_vvar}}")
        endif()
    endif()

    deps_rec_set(${NAME} FOUND TRUE)
    deps_rec_set(${NAME} RESOLVED_BY "apt")
    deps_rec_set(${NAME} LIBRARIES "${_libs}")
    deps_rec_set(${NAME} INCLUDE_DIRS "${_inc}")
    deps_rec_set(${NAME} DEFINITIONS "${_defs}")
    deps_rec_set(${NAME} VERSION "${_ver}")
endfunction()
