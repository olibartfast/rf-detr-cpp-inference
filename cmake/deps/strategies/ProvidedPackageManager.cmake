# cmake/deps/strategies/ProvidedPackageManager.cmake — Strategy: the shared
# fallback. ACQUIRE = DOWNLOAD (pinned URL+checksum) | VENDORED (third_party/) |
# ROOT (-D<NAME>_ROOT or legacy PROVIDER_ROOT_VARS). Used as the last link of
# every resolution chain.

include_guard(GLOBAL)

function(deps_provided_can_resolve NAME OUT_VAR)
    set(_ok FALSE)

    deps_decl_get(${NAME} PROVIDED_ROOT_VARS _root_vars)
    foreach(_rv ${_root_vars})
        if(DEFINED ${_rv})
            set_property(GLOBAL PROPERTY deps.provided.${NAME}.acquire "ROOT")
            set_property(GLOBAL PROPERTY deps.provided.${NAME}.root_var "${_rv}")
            set(_ok TRUE)
            set(${OUT_VAR} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()

    if(DEFINED ${NAME}_ROOT)
        set_property(GLOBAL PROPERTY deps.provided.${NAME}.acquire "ROOT")
        set_property(GLOBAL PROPERTY deps.provided.${NAME}.root_var "${NAME}_ROOT")
        set(${OUT_VAR} TRUE PARENT_SCOPE)
        return()
    endif()

    deps_decl_get(${NAME} PROVIDED_ACQUIRE _acq)
    if(_acq STREQUAL "DOWNLOAD")
        deps_decl_get(${NAME} PROVIDED_SUBDIR _sub)
        deps_decl_get(${NAME} PROVIDED_HEADER_GUARD _hg)
        if(DEPS_OFFLINE)
            if(EXISTS "${DEPS_PROVIDED_DIR}/${_sub}/${_hg}")
                set(_ok TRUE)
            endif()
        else()
            set(_ok TRUE)
        endif()
    elseif(_acq STREQUAL "VENDORED")
        deps_decl_get(${NAME} PROVIDED_VENDORED_DIR _vdir)
        if(EXISTS "${_vdir}")
            set(_ok TRUE)
        endif()
    elseif(_acq STREQUAL "FETCHCONTENT")
        if(NOT DEPS_OFFLINE)
            set(_ok TRUE)
        endif()
    endif()

    set_property(GLOBAL PROPERTY deps.provided.${NAME}.acquire "${_acq}")
    set(${OUT_VAR} ${_ok} PARENT_SCOPE)
endfunction()

function(deps_provided_resolve NAME)
    get_property(_acq GLOBAL PROPERTY deps.provided.${NAME}.acquire)
    if(_acq STREQUAL "ROOT")
        deps_provided_resolve_root(${NAME})
    elseif(_acq STREQUAL "DOWNLOAD")
        deps_provided_resolve_download(${NAME})
    elseif(_acq STREQUAL "VENDORED")
        deps_provided_resolve_vendored(${NAME})
    elseif(_acq STREQUAL "FETCHCONTENT")
        deps_provided_resolve_fetchcontent(${NAME})
    endif()
endfunction()

# Shared finalizer: given an install root, read the catalog coordinates and emit
# a complete ResolvedDependency record (libs, system includes, compile defs,
# version, RPATH dirs, runtime libs to copy, optional CUDA). Shared by the
# DOWNLOAD and ROOT paths so a cache-var ROOT populated by a prior download
# (e.g. ONNXRUNTIME_ROOTDIR on reconfigure) yields an identical record.
function(deps_provided_finalize NAME INSTALL_DIR)
    deps_decl_get(${NAME} PROVIDED_INCLUDE      _inc)
    deps_decl_get(${NAME} DEFINITIONS           _defs)
    deps_decl_get(${NAME} PROVIDED_VERSION      _ver)
    deps_decl_get(${NAME} PROVIDED_CUDA         _cuda)

    deps_decl_get(${NAME} PROVIDED_LIBRARIES _libs_rel)
    if(NOT _libs_rel)
        deps_decl_get(${NAME} PROVIDED_LIBRARY _libs_rel)
    endif()
    deps_decl_get(${NAME} PROVIDED_RUNTIME_LIBS _rt_rel)

    set(_inc_dir "${INSTALL_DIR}/${_inc}")

    set(_libs "")
    set(_rpath "")
    foreach(_rel ${_libs_rel})
        set(_f "${INSTALL_DIR}/${_rel}")
        if(NOT EXISTS "${_f}")
            message(FATAL_ERROR "[deps] ${NAME} library not found at ${_f}")
        endif()
        list(APPEND _libs "${_f}")
        get_filename_component(_d "${_f}" DIRECTORY)
        list(APPEND _rpath "${_d}")
    endforeach()

    set(_rt "")
    foreach(_rel ${_rt_rel})
        list(APPEND _rt "${INSTALL_DIR}/${_rel}")
    endforeach()

    if(_cuda STREQUAL "ON")
        find_package(CUDA QUIET)
        if(CUDA_FOUND)
            set(_cuda_lib ${CUDA_LIBRARIES})
        else()
            find_library(_cuda_lib cudart
                HINTS /usr/local/cuda/lib64 /usr/lib/x86_64-linux-gnu
                PATH_SUFFIXES lib lib64)
        endif()
        if(NOT _cuda_lib)
            message(FATAL_ERROR "[deps] CUDA runtime library not found. Please install CUDA toolkit.")
        endif()
        list(APPEND _libs "${_cuda_lib}")
        get_filename_component(_cd "${_cuda_lib}" DIRECTORY)
        list(APPEND _rpath "${_cd}")
    endif()

    list(REMOVE_DUPLICATES _rpath)

    deps_rec_set(${NAME} FOUND TRUE)
    deps_rec_set(${NAME} RESOLVED_BY "provided")
    deps_rec_set(${NAME} LIBRARIES "${_libs}")
    deps_rec_set(${NAME} INCLUDE_DIRS "${_inc_dir}")
    deps_rec_set(${NAME} DEFINITIONS "${_defs}")
    deps_rec_set(${NAME} VERSION "${_ver}")
    deps_rec_set(${NAME} RPATH_DIRS "${_rpath}")
    if(_rt)
        deps_rec_set(${NAME} RUNTIME_LIBS "${_rt}")
    endif()
endfunction()

function(deps_provided_resolve_download NAME)
    deps_decl_get(${NAME} PROVIDED_URL          _url)
    deps_decl_get(${NAME} PROVIDED_SUBDIR       _sub)
    deps_decl_get(${NAME} PROVIDED_HEADER_GUARD _hg)
    deps_decl_get(${NAME} PROVIDED_ROOT_CACHE   _cache)

    get_filename_component(_archive_name "${_url}" NAME)
    set(_archive "${DEPS_PROVIDED_DIR}/${_archive_name}")
    set(_install_dir "${DEPS_PROVIDED_DIR}/${_sub}")

    if(NOT EXISTS "${_install_dir}/${_hg}")
        file(MAKE_DIRECTORY "${DEPS_PROVIDED_DIR}")
        if(NOT EXISTS "${_archive}")
            if(DEPS_OFFLINE)
                message(FATAL_ERROR "[deps] ${NAME}: offline mode and '${_hg}' absent; "
                    "pre-populate ${_install_dir} or disable DEPS_OFFLINE.")
            endif()
            message(STATUS "[deps] downloading ${NAME} from ${_url}...")
            file(DOWNLOAD ${_url} "${_archive}" SHOW_PROGRESS TIMEOUT 600 STATUS _st)
            list(GET _st 0 _code)
            list(GET _st 1 _msg)
            if(NOT _code EQUAL 0)
                message(FATAL_ERROR "[deps] ${NAME} download failed: ${_msg}")
            endif()
        else()
            message(STATUS "[deps] using cached ${NAME} archive: ${_archive}")
        endif()
        message(STATUS "[deps] extracting ${_archive}...")
        execute_process(COMMAND ${CMAKE_COMMAND} -E tar xzf "${_archive}"
            WORKING_DIRECTORY "${DEPS_PROVIDED_DIR}" RESULT_VARIABLE _rc)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "[deps] ${NAME} extraction failed: ${_rc}")
        endif()
        if(NOT EXISTS "${_install_dir}/${_hg}")
            message(FATAL_ERROR "[deps] ${NAME}: expected '${_hg}' not found at ${_install_dir}")
        endif()
    else()
        message(STATUS "[deps] found existing ${NAME} at ${_install_dir}")
    endif()

    if(_cache)
        set(${_cache} "${_install_dir}" CACHE PATH "Path to ${NAME} root directory")
    endif()

    deps_provided_finalize(${NAME} "${_install_dir}")
endfunction()

function(deps_provided_resolve_root NAME)
    get_property(_root_var GLOBAL PROPERTY deps.provided.${NAME}.root_var)
    set(_root "${${_root_var}}")
    deps_decl_get(${NAME} PROVIDED_HEADER_GUARD _hg)
    if(_hg AND NOT EXISTS "${_root}/${_hg}")
        message(FATAL_ERROR "[deps] ${NAME}: ${_root_var}=${_root} missing '${_hg}'")
    endif()
    if(DEPS_DEBUG)
        message(STATUS "[deps] ${NAME} using provided ROOT ${_root_var}=${_root}")
    endif()
    deps_provided_finalize(${NAME} "${_root}")
endfunction()

function(deps_provided_resolve_vendored NAME)
    deps_decl_get(${NAME} PROVIDED_VENDORED_DIR _vdir)
    deps_decl_get(${NAME} DEFINITIONS _defs)
    deps_rec_set(${NAME} FOUND TRUE)
    deps_rec_set(${NAME} RESOLVED_BY "provided")
    deps_rec_set(${NAME} INCLUDE_DIRS "${_vdir}")
    deps_rec_set(${NAME} DEFINITIONS "${_defs}")
endfunction()

function(deps_provided_resolve_fetchcontent NAME)
    include(FetchContent)
    deps_decl_get(${NAME} PROVIDED_FC_REPO   _repo)
    deps_decl_get(${NAME} PROVIDED_FC_TAG    _tag)
    deps_decl_get(${NAME} PROVIDED_FC_TARGETS _targets)
    deps_decl_get(${NAME} DEFINITIONS        _defs)
    FetchContent_Declare(${NAME} GIT_REPOSITORY "${_repo}" GIT_TAG "${_tag}")
    FetchContent_MakeAvailable(${NAME})
    deps_rec_set(${NAME} FOUND TRUE)
    deps_rec_set(${NAME} RESOLVED_BY "provided")
    deps_rec_set(${NAME} LIBRARIES "${_targets}")
    deps_rec_set(${NAME} DEFINITIONS "${_defs}")
endfunction()
