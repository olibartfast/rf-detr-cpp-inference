# ==============================================================================
# Dependency Version Configuration for rf-detr-cpp-inference
# ==============================================================================
#
# Single source of truth for every third-party version this project pins.
# Nothing below is repeated anywhere else in the tree that can read a file:
#
#   cmake/versions.cmake  reads it for CMake (included before cmake/deps/Deps.cmake,
#                         so cmake/deps/packages/*.cmake see the values)
#   scripts/versions.sh   reads it for shell (`source` it; see scripts/fetch_dali.sh)
#
# Three formats cannot read a file at all — the Dockerfile's ARG defaults,
# conanfile.txt, and deploy/requirements.txt. Those restate the values, and
# scripts/check_version_sync.sh (run by lint.yml) fails the build when they
# drift from this file. Run it after any edit here:
#
#   ./scripts/check_version_sync.sh
#
# Every variable is overridable from the environment; the loaders never clobber
# a value that is already set:
#
#   TENSORRT_VERSION=10.14.1.48 ./scripts/ci/stage_gpu_headers.sh
#   cmake -S . -B build -DONNX_RUNTIME_VERSION=1.22.0
#
# ==============================================================================

# --- Inference backends (exactly one is compiled in) --------------------------
# ONNX Runtime: official CPU archive, github.com/microsoft/onnxruntime releases.
ONNX_RUNTIME_VERSION=1.21.0
# TensorRT: four-component NVIDIA version. The download URL, the Conan recipe and the
# .deb suffix all use truncations of it, derived by the loaders (the .deb form in
# scripts/versions.sh only) — do not add separate variables for those.
TENSORRT_VERSION=10.13.3.9
# ExecuTorch: git tag. The prefix must be built with EXECUTORCH_BUILD_KERNELS_OPTIMIZED=ON.
EXECUTORCH_VERSION=v1.4.0

# --- GPU stack (TensorRT backend only) ----------------------------------------
# CUDA Toolkit series TensorRT is built against; also the `cuda-<v>` tag in the
# TensorRT tarball name and the `+cuda<v>` suffix of its .deb packages.
CUDA_VERSION=13.0
# Default CMAKE_CUDA_ARCHITECTURES. 86 = RTX 30-series; override per machine.
CUDA_ARCHITECTURES=86
# NVIDIA DALI, as staged by scripts/ci/stage_gpu_headers.sh. Must match the DALI
# build inside NGC_CONTAINER_TAG below, which is what scripts/fetch_dali.sh uses.
DALI_VERSION=1.51.2
# NGC monthly container tag, shared by the tritonserver image (DALI staging and
# pipeline generation) and the tensorrt image (engine export).
NGC_CONTAINER_TAG=25.12

# --- Media backends -----------------------------------------------------------
# The apt path takes whatever the system has; these are the Conan coordinates.
# ffmpeg and sdl are live entries in conanfile.txt [requires]. OpenCV is NOT — it
# appears there only in the commented instruction for swapping to -DUSE_OPENCV=ON,
# so OPENCV_VERSION keeps that instruction honest rather than pinning a build.
FFMPEG_VERSION=6.1
SDL_VERSION=2.28.5
OPENCV_VERSION=4.8.1

# --- Testing ------------------------------------------------------------------
GTEST_VERSION=1.12.1
GOOGLE_BENCHMARK_VERSION=1.9.1

# --- Python export tooling (deploy/) ------------------------------------------
RFDETR_VERSION=1.9.4
ONNX_OPSET_VERSION=17

# --- Docker -------------------------------------------------------------------
DOCKER_BASE_IMAGE=ubuntu:24.04
